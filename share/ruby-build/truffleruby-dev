platform="$(uname -s)-$(uname -m)"
case $platform in
Linux-x86_64)
  url=$(curl https://raw.githubusercontent.com/graalvm/graal-languages-ea-builds/main/truffleruby/versions/latest-native-linux-amd64.url)
  ;;
Linux-aarch64)
  url=$(curl https://raw.githubusercontent.com/graalvm/graal-languages-ea-builds/main/truffleruby/versions/latest-native-linux-aarch64.url)
  ;;
Darwin-x86_64)
  url=$(curl https://raw.githubusercontent.com/graalvm/graal-languages-ea-builds/main/truffleruby/versions/latest-native-darwin-amd64.url)
  ;;
Darwin-arm64)
  url=$(curl https://raw.githubusercontent.com/graalvm/graal-languages-ea-builds/main/truffleruby/versions/latest-native-darwin-aarch64.url)
  ;;
*)
  colorize 1 "Unsupported platform: $platform"
  return 1
  ;;
esac

install_package "truffleruby-head" "$url" truffleruby
